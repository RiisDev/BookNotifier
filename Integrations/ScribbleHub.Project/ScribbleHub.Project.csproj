<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BookNotifier.csproj" />
  </ItemGroup>

	<Target Name="CopyOutputToBookNotifier" AfterTargets="Build">
		<ItemGroup>
			<BuildOutput Include="$(OutputPath)**\*" />
		</ItemGroup>

		<Copy
			SourceFiles="@(BuildOutput)"
			DestinationFiles="@(BuildOutput->'..\..\bin\$(Configuration)\$(TargetFramework)\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true" />
	</Target>
</Project>
